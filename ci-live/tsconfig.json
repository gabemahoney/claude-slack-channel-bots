{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun-types"],
    "typeRoots": ["./node_modules/@types", "../node_modules/@types", "../node_modules"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
