# docker/Dockerfile.live — the /ci-live image (bun ci-live/run.ts).
#
# Built on the /ci base, the same tag /ci builds (apt deps incl. tmux, bun,
# nodejs, cozempic, and agent-director's release-candidate binary in
# /opt/agent-director-rc/bin, first on PATH); nothing here changes the base
# layers. This image adds what a live run needs and /ci does not:
# - the agent-director binary the runner stages as the named build context
#   `agent-director-bin` (bun ci-live/run.ts builds with
#   `--build-context agent-director-bin=<dir>`), copied over the base's
#   /opt/agent-director-rc/bin/agent-director, which stays the first
#   agent-director on PATH, and the npm package at the range package.json
#   declares. The build fails when the binary's version is not the npm
#   package's or is below the package's version floor
#   (dist/version-floor.json);
# - real Claude Code (the bot Claudes answer real Slack messages), pinned;
# - `testuser` with the host's uid/gid, so the mode-600 credentials files the
#   runner bind-mounts read-only are readable in the container;
# - the live entrypoint and the testplan's shell helpers and pre-flight
#   (testplans/b.yko Part 1.3 and "Pre-flight", adapted to the container).
# The package under test is not in the image: the runner mounts its tarball
# at /tmp/package.tgz and installs it as a customer would.
FROM cscb-ci-base:v5

ARG HOST_UID=1000
ARG HOST_GID=1000
ARG CLAUDE_CODE_VERSION=2.1.280

COPY docker/live/entrypoint.sh /usr/local/bin/cscb-live-entrypoint.sh
COPY docker/live/cscb-live-helpers.sh docker/live/cscb-live-preflight.sh /opt/cscb-live/
COPY package.json /tmp/cscb-package.json
# Replaces the base image's binary at the same path, first on PATH, in a
# directory that holds nothing else.
COPY --from=agent-director-bin agent-director /opt/agent-director-rc/bin/agent-director

# One RUN: each separate RUN costs ~25 s of container-lifecycle overhead on
# this host (see docker/Dockerfile.test).
RUN set -eux; \
    AD_RANGE=$(jq -r '.dependencies["agent-director"]' /tmp/cscb-package.json); \
    rm /tmp/cscb-package.json; \
    bun add -g --ignore-scripts "agent-director@${AD_RANGE}"; \
    AD_SHIM_DIR=/root/.bun/install/global/node_modules/agent-director; \
    AD_SHIM_VERSION=$(jq -r '.version' "${AD_SHIM_DIR}/package.json"); \
    AD_FLOOR=$(jq -r '.min_binary_version' "${AD_SHIM_DIR}/dist/version-floor.json"); \
    chmod 0755 /opt/agent-director-rc/bin/agent-director; \
    if [ "$(command -v agent-director)" != /opt/agent-director-rc/bin/agent-director ]; then \
        echo "ERROR: agent-director on PATH is $(command -v agent-director), not the staged binary at /opt/agent-director-rc/bin/agent-director" >&2; \
        exit 1; \
    fi; \
    AD_BINARY_VERSION=$(agent-director version | jq -r '.version'); \
    if [ "${AD_BINARY_VERSION}" != "${AD_SHIM_VERSION}" ]; then \
        echo "ERROR: the host agent-director binary is ${AD_BINARY_VERSION}, but agent-director@${AD_RANGE} from npm is ${AD_SHIM_VERSION}: upgrade the host binary to ${AD_SHIM_VERSION} (the install-agent-director skill), then rerun" >&2; \
        exit 1; \
    fi; \
    if [ "$(printf '%s\n%s\n' "${AD_FLOOR}" "${AD_BINARY_VERSION}" | sort -V | head -n 1)" != "${AD_FLOOR}" ]; then \
        echo "ERROR: the host agent-director binary ${AD_BINARY_VERSION} is below the npm package's version floor ${AD_FLOOR}" >&2; \
        exit 1; \
    fi; \
    echo "agent-director: binary ${AD_BINARY_VERSION} (from the host), npm package ${AD_SHIM_VERSION} (range ${AD_RANGE}), floor ${AD_FLOOR}"; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    claude --version; \
    if ! getent group "${HOST_GID}" >/dev/null; then groupadd -g "${HOST_GID}" testuser; fi; \
    useradd -m -s /bin/bash -u "${HOST_UID}" -g "${HOST_GID}" testuser; \
    mkdir -p /home/testuser/.config /home/testuser/cscb-live; \
    chown -R "${HOST_UID}:${HOST_GID}" /home/testuser; \
    chmod 0755 /usr/local/bin/cscb-live-entrypoint.sh; \
    chmod 0644 /opt/cscb-live/cscb-live-helpers.sh /opt/cscb-live/cscb-live-preflight.sh

# DISABLE_AUTOUPDATER: the pinned Claude Code must stay the version under test.
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TERM=xterm-256color DISABLE_AUTOUPDATER=1
WORKDIR /home/testuser

ENTRYPOINT ["/usr/local/bin/cscb-live-entrypoint.sh"]
