# docker/Dockerfile.live — the /ci-live image (bun ci-live/run.ts).
#
# Built on the /ci base, the same tag /ci builds (apt deps incl. tmux, bun,
# nodejs, cozempic; agent-director's release binary alone in
# /opt/agent-director/bin, first on PATH; the release's npm client as the
# global agent-director client; the client-under-test check at
# /opt/agent-director/check/ad-client-check.sh). This image adds what a
# live run needs and /ci does not:
# - the agent-director binary the runner stages as the named build context
#   `agent-director-bin` (bun ci-live/run.ts builds with
#   `--build-context agent-director-bin=<dir>`), copied over the base's
#   /opt/agent-director/bin/agent-director, so it is the first
#   agent-director on PATH. The build checks it against the base's global
#   client, the release's, with ad-client-check.sh --client: the binary
#   reports the release record's version and commit (so its version is the
#   client's), that version is at or above the client's floor
#   (dist/version-floor.json), and Client.create() reports it. No
#   agent-director client is installed here and no package.json is read. On
#   a failed check the build stops with one ERROR line: a staged binary that
#   is not the release's (step 5) names the runner's --agent-director-binary
#   option; a release whose binary and client do not pair (steps 6 and 7)
#   names its pins in docker/Dockerfile.test.base; any other failure means
#   the base image predates this tree, and names docker/README.md's "When to
#   bump the base image version";
# - real Claude Code (the bot Claudes answer real Slack messages), pinned by
#   CLAUDE_CODE_VERSION at 2.1.280, the minimum agent-director states and the
#   version the fleet runs (agent-director's hooks are exec form, which Claude
#   Code runs from 2.1.139); the runner passes no override;
# - `testuser` with the host's uid/gid, so the mode-600 credentials files the
#   runner bind-mounts read-only are readable in the container;
# - the live entrypoint and the testplan's shell helpers and pre-flight
#   (testplans/b.yko Part 1.3 and "Pre-flight", adapted to the container).
# The package under test is not in the image: the runner mounts its tarball
# at /tmp/package.tgz and installs it as a customer would; the install check
# (ci-live/checks/setup-checks.ts) then checks the agent-director client it
# resolves with ad-client-check.sh --package.
FROM cscb-ci-base:v6

ARG HOST_UID=1000
ARG HOST_GID=1000
ARG CLAUDE_CODE_VERSION=2.1.280

COPY docker/live/entrypoint.sh /usr/local/bin/cscb-live-entrypoint.sh
COPY docker/live/cscb-live-helpers.sh docker/live/cscb-live-preflight.sh /opt/cscb-live/
# Replaces the base image's binary at the same path, first on PATH, in a
# directory that holds nothing else.
COPY --from=agent-director-bin agent-director /opt/agent-director/bin/agent-director

# One RUN: each separate RUN costs ~25 s of container-lifecycle overhead on
# this host (see docker/Dockerfile.test).
RUN set -eux; \
    chmod 0755 /opt/agent-director/bin/agent-director; \
    if [ "$(command -v agent-director)" != /opt/agent-director/bin/agent-director ]; then \
        echo "ERROR: agent-director on PATH is $(command -v agent-director), not the staged binary at /opt/agent-director/bin/agent-director" >&2; \
        exit 1; \
    fi; \
    if ! /opt/agent-director/check/ad-client-check.sh --client /root/.bun/install/global/node_modules/agent-director 2> /tmp/ad-client-check.err; then \
        cat /tmp/ad-client-check.err >&2; \
        if grep -qE '^ERROR: ad-client check 5 ' /tmp/ad-client-check.err; then \
            echo "ERROR: the staged agent-director binary is not the agent-director release this image's agent-director client is checked against (the ad-client check line above names what differs): stage that release's agent-director-linux-amd64 with the runner's --agent-director-binary option" >&2; \
        elif grep -qE '^ERROR: ad-client check [67] ' /tmp/ad-client-check.err; then \
            echo "ERROR: the agent-director release's binary and client do not pair (the ad-client check line above names what differs): the release pinned by AD_VERSION and AD_COMMIT in docker/Dockerfile.test.base is not usable as is; pin one whose binary and client pair and bump the base image version as the When to bump the base image version section of docker/README.md describes" >&2; \
        else \
            echo "ERROR: the base image's global agent-director client or its ad-client check failed (the line above names what failed): the base image cscb-ci-base:v6 predates this tree's docker/Dockerfile.test.base or docker/ad-client-check.sh; bump the base image version as the When to bump the base image version section of docker/README.md describes" >&2; \
        fi; \
        exit 1; \
    fi; \
    rm -f /tmp/ad-client-check.err; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    claude --version; \
    if ! getent group "${HOST_GID}" >/dev/null; then groupadd -g "${HOST_GID}" testuser; fi; \
    useradd -m -s /bin/bash -u "${HOST_UID}" -g "${HOST_GID}" testuser; \
    mkdir -p /home/testuser/.config /home/testuser/cscb-live; \
    chown -R "${HOST_UID}:${HOST_GID}" /home/testuser; \
    chmod 0755 /usr/local/bin/cscb-live-entrypoint.sh; \
    chmod 0644 /opt/cscb-live/cscb-live-helpers.sh /opt/cscb-live/cscb-live-preflight.sh

# DISABLE_AUTOUPDATER: the pinned Claude Code must stay the version under test.
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TERM=xterm-256color DISABLE_AUTOUPDATER=1
WORKDIR /home/testuser

ENTRYPOINT ["/usr/local/bin/cscb-live-entrypoint.sh"]
