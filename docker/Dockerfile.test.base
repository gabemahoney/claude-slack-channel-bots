# docker/Dockerfile.test.base — the /ci base image, cscb-ci-base:v6.
#
# Source-independent layers shared by the /ci image (docker/Dockerfile.test)
# and the /ci-live image (docker/Dockerfile.live). From the repo build context
# it reads one file, docker/ad-client-check.sh (no package.json). Built once
# per host by the /ci skill:
#
#   docker build --network=host --secret id=gh_token,env=GH_TOKEN \
#     --build-context agent-director-install=<directory holding install.sh> \
#     -f docker/Dockerfile.test.base -t cscb-ci-base:v6 .
#
# agent-director is the release pinned below (AD_VERSION, AD_COMMIT): its
# binaries come from agent-director's GitHub release, installed by that
# release's own install.sh (`--from-release`, both assets checked against
# their pinned SHA-256), and its TypeScript client from npm at the same
# version.
#
# Fixed paths (all readable by every user, testuser included, except the
# global client under /root, which is root-only):
#   /opt/agent-director/bin/agent-director
#       the release's binary, the image's default agent-director. Its
#       directory holds nothing else and is first on the default PATH, so a
#       scenario can leave it off PATH and still find bun.
#   /opt/agent-director/admin/agent-director-admin
#       the release's operator tool (`delete`, `kill-finished`), from the
#       same install; never on PATH. It and its directory are mode 0755, so
#       a scenario harness running as testuser can run it by this path
#       (install.sh --binary takes it as --admin-binary).
#   /opt/agent-director/install/install.sh
#       the release's install script, from agent-director's source tree at
#       the release tag; off PATH; its directory holds nothing else.
#   /opt/agent-director/client/agent-director-<AD_VERSION>.tgz
#       the release's TypeScript client tarball, fetched from the npm
#       registry and checked against its pinned SHA-256.
#   /opt/agent-director/client/release.json
#       the release record: {"version", "commit", "client_tarball",
#       "client_tarball_sha256"}.
#   /opt/agent-director/check/ad-client-check.sh
#       the client-under-test check (docker/ad-client-check.sh), off PATH:
#       `--package <dir>` checks the agent-director client an installed
#       package resolves; `--client <dir>` checks a client as it is. It
#       changes nothing. test-1, ci-live/checks/setup-checks.ts and
#       docker/Dockerfile.live run it.
#   /root/.bun/install/global/node_modules/agent-director
#       the global agent-director client: the release's, installed from npm
#       at the exact version and checked by the build. Root-only (/root is
#       0700): read by this base build and by docker/Dockerfile.live, which
#       both run as root; testuser cannot read it.
#   /opt/agent-director-0.10.0/bin/agent-director
#       agent-director 0.10.0's binary, off PATH.
#   /opt/agent-director-0.10.0/agent-director-0.10.0.tgz
#       the published agent-director 0.10.0 client, from npm.
#   /opt/claude-slack-channel-bots-0.10.0/claude-slack-channel-bots-0.10.0.tgz
#       the published pre-persona claude-slack-channel-bots 0.10.0 package,
#       from npm.
#   /etc/cscb-ci-image
#       the image marker: tests/runner.sh and ad-client-check.sh refuse to
#       run without it.
# The install leaves no store behind: install.sh runs with a throwaway HOME,
# which the build removes, so no ~/.agent-director exists in the image. The
# 0.10.0 client is only kept as its tarball, and /usr/local/bin holds no
# agent-director.
#
# Every failed check prints one line starting `ERROR:` naming its cause.

# Fallback stage for the named build context. A
# `--build-context agent-director-install=<dir>` replaces the stage of that
# name; without it the stage is a plain ubuntu root, which holds no
# install.sh, so the build stops with an ERROR line naming the missing
# context.
FROM ubuntu:22.04 AS agent-director-install

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# tmux: agent-director creates a tmux session per spawn (test-4 onward spawn
# real bots through it). sqlite3: the harness's store edits and reads.
# file: install.sh's pre-flight. The marker /etc/cscb-ci-image is written in
# this layer.
RUN apt-get update && apt-get install -y \
    curl \
    git \
    gosu \
    ca-certificates \
    gnupg \
    python3 \
    python3-pip \
    jq \
    unzip \
    tmux \
    sqlite3 \
    file \
    && rm -rf /var/lib/apt/lists/* \
    && printf 'cscb-ci image (docker/Dockerfile.test.base)\n' > /etc/cscb-ci-image \
    && chmod 0644 /etc/cscb-ci-image

# Bun — Test 1 uses `bun install /tmp/package.tgz`.
RUN curl -fsSL https://bun.sh/install | bash && cp /root/.bun/bin/bun /usr/local/bin/bun

# Node 20 — daemon-under-test runs on Node.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Cozempic — Test 3 probes for it on PATH.
RUN pip install cozempic

# The default agent-director binary's directory, first on the default PATH.
# The directory is created by the release layer below.
ENV PATH=/opt/agent-director/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The 0.10.0 legs, installable beside the release: the published
# agent-director 0.10.0 client and the published pre-persona
# claude-slack-channel-bots 0.10.0 package, kept as npm tarballs (fetched by
# exact version, no install scripts run).
ARG AD_PREV_VERSION=0.10.0
ARG CSCB_PREV_VERSION=0.10.0
RUN set -eu; \
    AD_PREV_DIR="/opt/agent-director-${AD_PREV_VERSION}"; \
    CSCB_PREV_DIR="/opt/claude-slack-channel-bots-${CSCB_PREV_VERSION}"; \
    mkdir -p "${AD_PREV_DIR}" "${CSCB_PREV_DIR}"; \
    npm pack --ignore-scripts --pack-destination "${AD_PREV_DIR}" "agent-director@${AD_PREV_VERSION}" >/dev/null \
        || { echo "ERROR: npm pack agent-director@${AD_PREV_VERSION} failed" >&2; exit 1; }; \
    npm pack --ignore-scripts --pack-destination "${CSCB_PREV_DIR}" "claude-slack-channel-bots@${CSCB_PREV_VERSION}" >/dev/null \
        || { echo "ERROR: npm pack claude-slack-channel-bots@${CSCB_PREV_VERSION} failed" >&2; exit 1; }; \
    for pkg in "${AD_PREV_DIR}/agent-director-${AD_PREV_VERSION}.tgz" "${CSCB_PREV_DIR}/claude-slack-channel-bots-${CSCB_PREV_VERSION}.tgz"; do \
        [ -s "${pkg}" ] || { echo "ERROR: npm pack wrote no ${pkg}" >&2; exit 1; }; \
    done; \
    chmod -R a+rX "${AD_PREV_DIR}" "${CSCB_PREV_DIR}"

# agent-director 0.10.0's binary, fetched for the pinned release v0.10.0 into
# /opt/agent-director-0.10.0/bin, which is not on PATH. This leg reads the
# release through GitHub's API with a token, so a GitHub token is required at
# build time, as the BuildKit secret `gh_token` (see the /ci skill):
#   docker build --secret id=gh_token,env=GH_TOKEN ...
# Never pass it as a build-arg or ENV: an ARG's value is recorded in the image
# history (`docker history --no-trunc`) of this image and of every image built
# on it, and the build log prints it. A secret mount exists only while this RUN
# runs (at /run/secrets/gh_token), and the token reaches curl only on its
# standard input (`-K -`), never on a command line.
RUN --mount=type=secret,id=gh_token set -eu; \
    AD_TAG="v${AD_PREV_VERSION}"; \
    AD_PREV_BIN_DIR="/opt/agent-director-${AD_PREV_VERSION}/bin"; \
    AD_PREV_BIN="${AD_PREV_BIN_DIR}/agent-director"; \
    if [ ! -s /run/secrets/gh_token ]; then \
        echo "ERROR: the gh_token build secret is required (the agent-director ${AD_PREV_VERSION} leg reads its release through GitHub's API with a token): pass it with docker build --secret id=gh_token,env=GH_TOKEN, GH_TOKEN set in that command's environment" >&2; \
        exit 1; \
    fi; \
    gh_auth() { printf 'header = "Authorization: Bearer %s"\n' "$(cat /run/secrets/gh_token)"; }; \
    RELEASE_JSON=$(gh_auth | curl -fsSL -K - \
        "https://api.github.com/repos/gabemahoney/agent-director/releases/tags/${AD_TAG}") \
        || { echo "ERROR: could not read agent-director release ${AD_TAG} from GitHub" >&2; exit 1; }; \
    ASSET_ID=$(printf '%s' "${RELEASE_JSON}" | jq -r '.assets[] | select(.name == "agent-director-linux-amd64") | .id') \
        || { echo "ERROR: GitHub's response for agent-director release ${AD_TAG} is not a JSON release object with an assets list" >&2; exit 1; }; \
    if [ -z "${ASSET_ID}" ] || [ "${ASSET_ID}" = "null" ]; then \
        echo "ERROR: no agent-director-linux-amd64 asset on release ${AD_TAG}" >&2; \
        exit 1; \
    fi; \
    mkdir -p "${AD_PREV_BIN_DIR}"; \
    gh_auth | curl -fsSL -K - \
        -H "Accept: application/octet-stream" \
        -o "${AD_PREV_BIN}" \
        "https://api.github.com/repos/gabemahoney/agent-director/releases/assets/${ASSET_ID}" \
        || { echo "ERROR: could not download agent-director-linux-amd64 from release ${AD_TAG}" >&2; exit 1; }; \
    chmod 0755 "${AD_PREV_BIN_DIR}" "${AD_PREV_BIN}"; \
    PREV_VERSION_JSON=$("${AD_PREV_BIN}" version) \
        || { echo "ERROR: ${AD_PREV_BIN} version failed" >&2; exit 1; }; \
    PREV_REPORTED=$(printf '%s' "${PREV_VERSION_JSON}" | jq -ner 'input | .version | strings') \
        || { echo "ERROR: ${AD_PREV_BIN} version did not print a JSON object with a string version field" >&2; exit 1; }; \
    if [ "${PREV_REPORTED}" != "${AD_PREV_VERSION}" ]; then \
        echo "ERROR: ${AD_PREV_BIN} reports version ${PREV_REPORTED}, not ${AD_PREV_VERSION}" >&2; \
        exit 1; \
    fi; \
    echo "agent-director ${PREV_REPORTED} binary installed off PATH at ${AD_PREV_BIN}"

# The release: its install script, read only from the named build context
# agent-director-install (never from the repo context), then run to install
# the release's binaries.
# - agent-director-install: a directory holding install.sh, taken from
#   agent-director's source tree at the release tag v${AD_VERSION} (the /ci
#   skill fills it with a read-only `git show`); it must match the pinned
#   AD_INSTALL_SH_SHA256. It goes to /opt/agent-director/install (off PATH).
# - That install.sh then installs the release: `--from-release
#   v${AD_VERSION}` downloads agent-director-linux-amd64 and
#   agent-director-admin-linux-amd64 from agent-director's GitHub release
#   (its public download URLs; no token is passed), checks them against the pinned AD_SHA256 and
#   AD_ADMIN_SHA256 (`--sha256`, `--admin-sha256`), refuses a pair whose
#   version stamps differ, installs them and opens the store, migrating it to
#   the release's schema. It runs with a throwaway HOME (its
#   ~/.agent-director, store included, is removed afterwards), with
#   `--no-hooks` and `--no-symlink`, and with a stand-in `claude` on PATH for
#   that one command: install.sh's pre-flight requires a `claude` on PATH and
#   only prints its `--version`, and this image has no Claude Code.
# The installed agent-director goes to /opt/agent-director/bin (first on
# PATH, nothing else in it) and agent-director-admin to
# /opt/agent-director/admin (mode 0755, never on PATH). Each must still match
# its pinned SHA-256, and agent-director's `version` must report the pinned
# AD_VERSION and AD_COMMIT. The build then checks that the first
# agent-director on PATH is the release's, that no other PATH directory holds
# one, and that no agent-director-admin is on PATH.
ARG AD_VERSION=0.11.0
ARG AD_COMMIT=d0b1890d12e286c842439815fd6b8ecdb790bc24
ARG AD_SHA256=a72e4c5001b96294427e06e3972c82b3f070ef8932a0fc83aef1dc73418747bf
ARG AD_ADMIN_SHA256=103c1ee017230f5b6e97224b403a23cf942a332cf3e74bb30f7dd0072bf0dbb6
ARG AD_INSTALL_SH_SHA256=be9de3727b1ddbeec333b1ee70634b4b6cbad39aca81fbd8d2b8ed41fe993825
RUN --mount=type=bind,from=agent-director-install,target=/mnt/agent-director-install \
    set -eu; \
    AD_TAG="v${AD_VERSION}"; \
    INSTALL_CTX=/mnt/agent-director-install; \
    AD_ROOT=/opt/agent-director; \
    AD_BIN_DIR="${AD_ROOT}/bin"; \
    AD_BIN="${AD_BIN_DIR}/agent-director"; \
    AD_ADMIN_DIR="${AD_ROOT}/admin"; \
    AD_ADMIN="${AD_ADMIN_DIR}/agent-director-admin"; \
    AD_INSTALL_DIR="${AD_ROOT}/install"; \
    AD_INSTALL_SH="${AD_INSTALL_DIR}/install.sh"; \
    if [ ! -f "${INSTALL_CTX}/install.sh" ]; then \
        echo "ERROR: the agent-director-install build context is missing or holds no install.sh: pass --build-context agent-director-install=<directory holding install.sh from agent-director's tree at ${AD_TAG}>" >&2; \
        exit 1; \
    fi; \
    STAGE=$(mktemp -d); \
    cp "${INSTALL_CTX}/install.sh" "${STAGE}/install.sh"; \
    INSTALL_SH_SHA256=$(sha256sum "${STAGE}/install.sh" | cut -d' ' -f1); \
    if [ "${INSTALL_SH_SHA256}" != "${AD_INSTALL_SH_SHA256}" ]; then \
        echo "ERROR: install.sh in the agent-director-install build context has SHA-256 ${INSTALL_SH_SHA256}, not the pinned ${AD_INSTALL_SH_SHA256} (agent-director ${AD_TAG})" >&2; \
        exit 1; \
    fi; \
    mkdir -p "${AD_INSTALL_DIR}"; \
    install -m 0755 "${STAGE}/install.sh" "${AD_INSTALL_SH}"; \
    AD_HOME="${STAGE}/home"; \
    SHIM_DIR="${STAGE}/shim"; \
    mkdir -p "${AD_HOME}" "${SHIM_DIR}"; \
    printf '%s\n' '#!/bin/sh' 'echo "claude: build-time stand-in for install.sh pre-flight (no Claude Code in this image)"' > "${SHIM_DIR}/claude"; \
    chmod 0755 "${SHIM_DIR}/claude"; \
    if ! HOME="${AD_HOME}" PATH="${SHIM_DIR}:${PATH}" bash "${AD_INSTALL_SH}" --from-release "${AD_TAG}" \
            --sha256 "${AD_SHA256}" --admin-sha256 "${AD_ADMIN_SHA256}" --no-hooks --no-symlink \
            > "${STAGE}/install.out" 2> "${STAGE}/install.err"; then \
        echo "ERROR: ${AD_INSTALL_SH} --from-release ${AD_TAG} failed: $(tr -s '\n\t ' ' ' < "${STAGE}/install.err" | cut -c1-800)" >&2; \
        exit 1; \
    fi; \
    INSTALLED_BIN="${AD_HOME}/.agent-director/bin/agent-director"; \
    INSTALLED_ADMIN="${AD_HOME}/.agent-director/admin/agent-director-admin"; \
    for f in "${INSTALLED_BIN}" "${INSTALLED_ADMIN}"; do \
        if [ ! -f "${f}" ]; then \
            echo "ERROR: ${AD_INSTALL_SH} --from-release ${AD_TAG} installed no ${f}" >&2; \
            exit 1; \
        fi; \
    done; \
    STORE_SCHEMA=$(sqlite3 "${AD_HOME}/.agent-director/state.db" 'PRAGMA user_version;' 2>/dev/null || echo unreadable); \
    mkdir -p "${AD_BIN_DIR}" "${AD_ADMIN_DIR}"; \
    install -m 0755 "${INSTALLED_BIN}" "${AD_BIN}"; \
    install -m 0755 "${INSTALLED_ADMIN}" "${AD_ADMIN}"; \
    rm -rf "${STAGE}"; \
    BIN_SHA256=$(sha256sum "${AD_BIN}" | cut -d' ' -f1); \
    if [ "${BIN_SHA256}" != "${AD_SHA256}" ]; then \
        echo "ERROR: ${AD_BIN} has SHA-256 ${BIN_SHA256}, not the pinned AD_SHA256 ${AD_SHA256} of the release's agent-director-linux-amd64" >&2; \
        exit 1; \
    fi; \
    ADMIN_SHA256=$(sha256sum "${AD_ADMIN}" | cut -d' ' -f1); \
    if [ "${ADMIN_SHA256}" != "${AD_ADMIN_SHA256}" ]; then \
        echo "ERROR: ${AD_ADMIN} has SHA-256 ${ADMIN_SHA256}, not the pinned AD_ADMIN_SHA256 ${AD_ADMIN_SHA256} of the release's agent-director-admin-linux-amd64" >&2; \
        exit 1; \
    fi; \
    VERSION_JSON=$("${AD_BIN}" version) \
        || { echo "ERROR: ${AD_BIN} version failed" >&2; exit 1; }; \
    REPORTED_VERSION=$(printf '%s' "${VERSION_JSON}" | jq -ner 'input | .version | strings') \
        || { echo "ERROR: ${AD_BIN} version did not print a JSON object with a string version field" >&2; exit 1; }; \
    REPORTED_COMMIT=$(printf '%s' "${VERSION_JSON}" | jq -ner 'input | .commit | strings') \
        || { echo "ERROR: ${AD_BIN} version did not print a JSON object with a string commit field" >&2; exit 1; }; \
    if [ "${REPORTED_VERSION}" != "${AD_VERSION}" ]; then \
        echo "ERROR: the release's binary ${AD_BIN} reports version ${REPORTED_VERSION}, not the pinned AD_VERSION ${AD_VERSION}" >&2; \
        exit 1; \
    fi; \
    if [ "${REPORTED_COMMIT}" != "${AD_COMMIT}" ]; then \
        echo "ERROR: the release's binary ${AD_BIN} reports commit ${REPORTED_COMMIT}, not the pinned AD_COMMIT ${AD_COMMIT}" >&2; \
        exit 1; \
    fi; \
    chmod -R a+rX "${AD_ROOT}"; \
    chmod 0755 "${AD_ADMIN_DIR}" "${AD_ADMIN}"; \
    if [ "$(command -v agent-director)" != "${AD_BIN}" ]; then \
        echo "ERROR: the first agent-director on PATH is $(command -v agent-director || echo none), not ${AD_BIN}" >&2; \
        exit 1; \
    fi; \
    if [ "$(ls -A "${AD_BIN_DIR}")" != agent-director ]; then \
        echo "ERROR: ${AD_BIN_DIR} holds more than agent-director" >&2; \
        exit 1; \
    fi; \
    OTHERS=$(IFS=:; for d in ${PATH}; do [ "${d}" != "${AD_BIN_DIR}" ] && [ -e "${d}/agent-director" ] && echo "${d}/agent-director"; done; true); \
    if [ -n "${OTHERS}" ]; then \
        echo "ERROR: another agent-director is on PATH: $(echo ${OTHERS})" >&2; \
        exit 1; \
    fi; \
    if command -v agent-director-admin >/dev/null 2>&1; then \
        echo "ERROR: agent-director-admin is on PATH at $(command -v agent-director-admin); it must stay off PATH" >&2; \
        exit 1; \
    fi; \
    echo "agent-director ${REPORTED_VERSION} (${REPORTED_COMMIT}) installed by ${AD_INSTALL_SH} --from-release ${AD_TAG} at ${AD_BIN}, agent-director-admin at ${AD_ADMIN} (off PATH); the install's store reached schema v${STORE_SCHEMA}"

# The client-under-test check, the one file this image reads from the repo
# context, at a fixed path off PATH and outside the default binary's
# directory. It refuses to run without /etc/cscb-ci-image (written above).
COPY --chmod=0755 docker/ad-client-check.sh /opt/agent-director/check/ad-client-check.sh

# The release's client: its npm tarball, fetched from the registry by exact
# version and checked against the pinned AD_CLIENT_TGZ_SHA256, then the
# release record naming the release's version and commit and that tarball.
# The global agent-director client is then installed from npm at exactly
# AD_VERSION (it has no dependencies and no install scripts run) and checked
# with the check's client-only use: its version is the release's, its files
# equal the tarball's, it exports the Phase 1 classes, and it pairs with the
# release's binary first on PATH. The check's summary line is the last line
# this layer prints.
ARG AD_CLIENT_TGZ_SHA256=69cf2d1774c77ee706edb6e6d0d67049dd1039596c8e5239f26b03a8e71baa31
RUN set -eu; \
    AD_CHECK=/opt/agent-director/check/ad-client-check.sh; \
    CLIENT_DIR=/opt/agent-director/client; \
    CLIENT_TGZ="${CLIENT_DIR}/agent-director-${AD_VERSION}.tgz"; \
    CLIENT_TGZ_URL="https://registry.npmjs.org/agent-director/-/agent-director-${AD_VERSION}.tgz"; \
    GLOBAL_CLIENT=/root/.bun/install/global/node_modules/agent-director; \
    mkdir -p "${CLIENT_DIR}"; \
    curl -fsSL -o "${CLIENT_TGZ}" "${CLIENT_TGZ_URL}" \
        || { echo "ERROR: could not download the agent-director ${AD_VERSION} client tarball from ${CLIENT_TGZ_URL}" >&2; exit 1; }; \
    CLIENT_TGZ_SHA256=$(sha256sum "${CLIENT_TGZ}" | cut -d' ' -f1); \
    if [ "${CLIENT_TGZ_SHA256}" != "${AD_CLIENT_TGZ_SHA256}" ]; then \
        echo "ERROR: the agent-director ${AD_VERSION} client tarball from npm has SHA-256 ${CLIENT_TGZ_SHA256}, not the pinned AD_CLIENT_TGZ_SHA256 ${AD_CLIENT_TGZ_SHA256}" >&2; \
        exit 1; \
    fi; \
    jq -n --arg version "${AD_VERSION}" --arg commit "${AD_COMMIT}" \
        --arg client_tarball "${CLIENT_TGZ}" --arg client_tarball_sha256 "${AD_CLIENT_TGZ_SHA256}" \
        '{version: $version, commit: $commit, client_tarball: $client_tarball, client_tarball_sha256: $client_tarball_sha256}' \
        > "${CLIENT_DIR}/release.json"; \
    chmod -R a+rX "${CLIENT_DIR}"; \
    bun add -g --ignore-scripts "agent-director@${AD_VERSION}" > /tmp/ad-client-install.log 2>&1 \
        || { echo "ERROR: bun add -g agent-director@${AD_VERSION} failed: $(tail -n 1 /tmp/ad-client-install.log)" >&2; exit 1; }; \
    rm -f /tmp/ad-client-install.log; \
    if [ ! -f "${GLOBAL_CLIENT}/package.json" ]; then \
        echo "ERROR: bun add -g agent-director@${AD_VERSION} left no client at ${GLOBAL_CLIENT}" >&2; \
        exit 1; \
    fi; \
    "${AD_CHECK}" --client "${GLOBAL_CLIENT}"
