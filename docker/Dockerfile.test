FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    git \
    gosu \
    ca-certificates \
    gnupg \
    python3 \
    python3-pip \
    jq \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Bun — Test 1 uses `bun install /tmp/package.tgz`.
RUN curl -fsSL https://bun.sh/install | bash && cp /root/.bun/bin/bun /usr/local/bin/bun

# Node 20 — daemon-under-test runs on Node.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Cozempic — Test 3 probes for it on PATH.
RUN pip install cozempic

# agent-director — explicit install at the range CSCB declares in package.json.
# Own layer so CSCB source changes don't bust the AD pull; populates bun's cache
# so test-1's `bun install /tmp/package.tgz` resolves AD without network.
COPY package.json /tmp/package-for-ad-resolve.json
RUN AD_RANGE=$(jq -r '.dependencies["agent-director"]' /tmp/package-for-ad-resolve.json) && \
    bun add -g "agent-director@${AD_RANGE}" && \
    rm /tmp/package-for-ad-resolve.json

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Bash integration tests — runner.sh + the three test scripts.
COPY tests /tests
RUN chmod +x /tests/runner.sh /tests/integration/*.sh

# Testplans hive — human-prose source of truth for what gets tested.
COPY testplans /test-repo/testplans

RUN useradd -m -s /bin/bash testuser && chown -R testuser:testuser /test-repo

WORKDIR /test-repo

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
